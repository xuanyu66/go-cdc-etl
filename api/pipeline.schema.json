{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local CDC Pipeline v1",
  "description": "Implemented MVP: exactly one source -> one Lua -> 1..16 local sinks. Graph and decimal precision/key constraints also require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "kind": {
      "const": "Pipeline"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        }
      },
      "required": [
        "name"
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                  },
                  "type": {
                    "const": "source.mysql"
                  },
                  "mysql": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "connection_ref": {
                        "const": "mysql-local"
                      },
                      "tables": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
                        },
                        "minItems": 1,
                        "maxItems": 16,
                        "uniqueItems": true
                      },
                      "start": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "mode": {
                            "const": "current"
                          }
                        },
                        "required": [
                          "mode"
                        ]
                      }
                    },
                    "required": [
                      "connection_ref",
                      "tables",
                      "start"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "mysql"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                  },
                  "type": {
                    "const": "transform.lua"
                  },
                  "lua": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "function_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timeout_ms": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5000
                      }
                    },
                    "required": [
                      "function_ref",
                      "timeout_ms"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "lua"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                  },
                  "type": {
                    "const": "sink.local"
                  },
                  "local": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "output": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                      },
                      "key_fields": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                            },
                            "type": {
                              "type": "string",
                              "pattern": "^(string|bool|int64|uint64|float64|decimal\\([1-9][0-9]?,[0-9]{1,2}\\))$"
                            },
                            "required": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "name",
                            "type",
                            "required"
                          ]
                        },
                        "minItems": 1,
                        "maxItems": 100
                      }
                    },
                    "required": [
                      "output",
                      "key_fields",
                      "fields"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "local"
                ]
              }
            ]
          },
          "minItems": 3,
          "maxItems": 18
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          "minItems": 2,
          "maxItems": 17,
          "uniqueItems": true
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ]
}
