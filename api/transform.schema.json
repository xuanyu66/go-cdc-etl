{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lua transform(event) input and mutation output",
  "description": "Lua returns a continuous array of mutations. Exact integer/decimal values are strings. Null maps to etl.null. This schema describes user contracts, not internal worker IPC.",
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "row_index": {
          "type": "integer",
          "minimum": 0
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "insert",
            "update",
            "delete"
          ]
        },
        "before": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "after": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "type",
              "required"
            ]
          }
        },
        "source_position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "file",
            "position"
          ]
        }
      },
      "required": [
        "event_id",
        "source_id",
        "transaction_id",
        "row_index",
        "database",
        "table",
        "op",
        "before",
        "after",
        "columns",
        "source_position"
      ]
    },
    "mutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
            },
            "op": {
              "const": "upsert"
            },
            "key": {
              "type": "object",
              "minProperties": 1
            },
            "value": {
              "type": "object"
            }
          },
          "required": [
            "output",
            "op",
            "key",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "output": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,62}$"
            },
            "op": {
              "const": "delete"
            },
            "key": {
              "type": "object",
              "minProperties": 1
            }
          },
          "required": [
            "output",
            "op",
            "key"
          ]
        }
      ]
    },
    "result": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "output": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              },
              "op": {
                "const": "upsert"
              },
              "key": {
                "type": "object",
                "minProperties": 1
              },
              "value": {
                "type": "object"
              }
            },
            "required": [
              "output",
              "op",
              "key",
              "value"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "output": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              },
              "op": {
                "const": "delete"
              },
              "key": {
                "type": "object",
                "minProperties": 1
              }
            },
            "required": [
              "output",
              "op",
              "key"
            ]
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/result"
    }
  ]
}
