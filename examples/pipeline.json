{
  "api_version": "v1",
  "kind": "Pipeline",
  "metadata": {
    "name": "orders-export"
  },
  "spec": {
    "nodes": [
      {
        "id": "mysql",
        "type": "source.mysql",
        "mysql": {
          "connection_ref": "mysql-local",
          "tables": [
            "shop.orders"
          ],
          "start": {
            "mode": "current"
          }
        }
      },
      {
        "id": "normalize",
        "type": "transform.lua",
        "lua": {
          "function_ref": "REPLACE_WITH_FUNCTION_ID",
          "timeout_ms": 2000
        }
      },
      {
        "id": "archive",
        "type": "sink.local",
        "local": {
          "output": "orders",
          "key_fields": [
            "order_id"
          ],
          "fields": [
            {
              "name": "order_id",
              "type": "string",
              "required": true
            },
            {
              "name": "customer_id",
              "type": "string",
              "required": true
            },
            {
              "name": "total",
              "type": "decimal(18,2)",
              "required": true
            }
          ]
        }
      }
    ],
    "edges": [
      {
        "from": "mysql",
        "to": "normalize"
      },
      {
        "from": "normalize",
        "to": "archive"
      }
    ]
  }
}
